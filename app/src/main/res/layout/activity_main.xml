<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <Button
        android:id="@+id/bt_bind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bt_bind" />

    <Button
        android:id="@+id/bt_auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bt_auto" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_update_seat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_update_seat"
            android:text="front_left" />

        <Button
            android:id="@+id/bt_update_seat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bt_update_seat" />
    </LinearLayout>

    <Button
        android:id="@+id/bt_stop_detect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bt_stop_detect" />

    <Button
        android:id="@+id/bt_unbind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bt_unbind" />

    <Button
        android:id="@+id/bt_toast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bt_toast" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_preview_camera_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_preview_camera_id"
            android:inputType="number"
            android:text="13" />

        <Button
            android:id="@+id/bt_open_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bt_open_preview" />
    </LinearLayout>

    <Button
        android:id="@+id/bt_close_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bt_close_preview" />

    <TextureView
        android:id="@+id/sv_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:keepScreenOn="true" />

</LinearLayout>
